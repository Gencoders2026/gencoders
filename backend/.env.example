# Copy this file to .env and fill in real values

# MySQL connection
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/support_simulator

# JWT
SECRET_KEY=change_this_to_a_long_random_secret_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# File uploads (FAQ / policy documents)
UPLOAD_DIR=uploads/documents
MAX_UPLOAD_MB=20

# First admin account, auto-created on startup if no admin exists
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Admin@12345
FIRST_ADMIN_NAME=Super Admin
